# Copy this file to .env, then replace every placeholder secret.
# Do not upload .env to a public repository.

# InfluxDB first-time initialization
INFLUX_USERNAME=bems_admin
INFLUX_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
INFLUX_ORG=bems-org
INFLUX_BUCKET=bems
INFLUX_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# MQTT / backend uses Docker service names inside the Compose network
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=bems/telemetry
MQTT_COMMAND_PREFIX=bems/commands
MQTT_ALERT_TOPIC=bems/alerts

# Vietnam timezone
TIMEZONE=Asia/Ho_Chi_Minh

# EVN tariff profile: choose the actual customer category on the electricity contract.
# education_lv             Education institution, low voltage: 2,030 VND/kWh flat
# education_mv             Education institution, medium-and-above: 1,901 VND/kWh flat
# public_service_lv        Public lighting / administrative, low voltage: 2,181 VND/kWh
# production_lv            Production, low voltage: normal/off-peak/peak
# commercial_other_lv      Other commercial, low voltage: normal/off-peak/peak
# residential              Household 5 progressive tiers (not 3-period TOU)
TARIFF_PROFILE=education_lv
VAT_RATE=0.0

# AI model settings
# 720 hourly samples = 30 days. Keep this for a more defensible training history.
LSTM_MIN_HISTORY_HOURS=720
LSTM_RETRAIN_SECONDS=43200
ANOMALY_MIN_SAMPLES=200
ANOMALY_TRAIN_INTERVAL_SECONDS=300
ANOMALY_ALERT_COOLDOWN_SECONDS=900
NIGHT_HIGH_POWER_W=1500
MODEL_DIR=/app/models

# Demand Response: software demonstration only. Never set DRY_RUN to false.
DR_ENABLED=true
DRY_RUN=true
DR_BUILDING_LIMIT_W=6500
DR_SHEDTABLE_ROOM_IDS=17,18,19,20
DR_ESTIMATE_MINUTES=15
DR_COMMAND_COOLDOWN_SECONDS=1800
DR_VIRTUAL_REDUCTION_PERCENT=75

LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_PASSWORD
