// ------------------------------ DATA STRUCTURES ------------------------------

struct PzemMeasurement {
  float voltageV = 0.0f;
  float currentA = 0.0f;
  float powerW = 0.0f;
  float energyKWh = 0.0f;
  float powerFactor = 0.0f;
  float frequencyHz = 0.0f;
  bool valid = false;
};

// ------------------------------ HELPER FUNCTIONS -----------------------------

void copyToBuffer(char *destination, size_t destinationSize, const String &value) {
  if (destinationSize == 0) return;
  size_t count = value.length();
  if (count >= destinationSize) count = destinationSize - 1;
  memcpy(destination, value.c_str(), count);
  destination[count] = '\0';
}

void loadBrokerSettings() {
  preferencesReady = preferences.begin("bems-hybrid", false);
  if (!preferencesReady) {
    Serial.println("ERROR: Could not open Preferences namespace; using compiled defaults.");
    return;
  }

  copyToBuffer(localMqttHost, sizeof(localMqttHost),
               preferences.getString("localHost", localMqttHost));
  copyToBuffer(localMqttPort, sizeof(localMqttPort),
               preferences.getString("localPort", localMqttPort));
  copyToBuffer(localMqttUser, sizeof(localMqttUser),
               preferences.getString("localUser", localMqttUser));
  copyToBuffer(localMqttPassword, sizeof(localMqttPassword),
               preferences.getString("localPass", localMqttPassword));

  copyToBuffer(cloudMqttHost, sizeof(cloudMqttHost),
               preferences.getString("cloudHost", cloudMqttHost));
  copyToBuffer(cloudMqttPort, sizeof(cloudMqttPort),
               preferences.getString("cloudPort", cloudMqttPort));
  copyToBuffer(cloudMqttUser, sizeof(cloudMqttUser),
               preferences.getString("cloudUser", cloudMqttUser));
  copyToBuffer(cloudMqttPassword, sizeof(cloudMqttPassword),
               preferences.getString("cloudPass", cloudMqttPassword));
  copyToBuffer(cloudMqttTopic, sizeof(cloudMqttTopic),
               preferences.getString("cloudTopic", cloudMqttTopic));
}

void saveBrokerSettings() {
  if (!preferencesReady) {
    Serial.println("ERROR: Preferences unavailable; broker settings were not saved.");
    return;
  }

  preferences.putString("localHost", localMqttHost);
  preferences.putString("localPort", localMqttPort);
  preferences.putString("localUser", localMqttUser);
  preferences.putString("localPass", localMqttPassword);
  preferences.putString("cloudHost", cloudMqttHost);
  preferences.putString("cloudPort", cloudMqttPort);
  preferences.putString("cloudUser", cloudMqttUser);
  preferences.putString("cloudPass", cloudMqttPassword);
  preferences.putString("cloudTopic", cloudMqttTopic);

  Serial.println("Broker settings saved to ESP32 NVS (password not displayed).");
}

void buildProvisioningPortal() {
  portalLocalHost = new WiFiManagerParameter(
      "local_host", "Local MQTT host / Ubuntu Server LAN IP",
      localMqttHost, sizeof(localMqttHost));
  portalLocalPort = new WiFiManagerParameter(
      "local_port", "Local MQTT port", localMqttPort, sizeof(localMqttPort));
  portalLocalUser = new WiFiManagerParameter(
      "local_user", "Local MQTT username", localMqttUser, sizeof(localMqttUser));
  portalLocalPassword = new WiFiManagerParameter(
      "local_pass", "Local MQTT password", localMqttPassword,
      sizeof(localMqttPassword), "type='password' autocomplete='new-password'");

  portalCloudHost = new WiFiManagerParameter(
      "cloud_host", "Cloud MQTT hostname (optional)", cloudMqttHost, sizeof(cloudMqttHost));
  portalCloudPort = new WiFiManagerParameter(
      "cloud_port", "Cloud MQTT TLS port", cloudMqttPort, sizeof(cloudMqttPort));
  portalCloudUser = new WiFiManagerParameter(
      "cloud_user", "Cloud MQTT username / device token", cloudMqttUser, sizeof(cloudMqttUser));
  portalCloudPassword = new WiFiManagerParameter(
      "cloud_pass", "Cloud MQTT password (optional)", cloudMqttPassword,
      sizeof(cloudMqttPassword), "type='password' autocomplete='new-password'");
  portalCloudTopic = new WiFiManagerParameter(
      "cloud_topic", "Cloud telemetry topic", cloudMqttTopic, sizeof(cloudMqttTopic));

  wifiManager.addParameter(portalLocalHost);
  wifiManager.addParameter(portalLocalPort);
  wifiManager.addParameter(portalLocalUser);
  wifiManager.addParameter(portalLocalPassword);
  wifiManager.addParameter(portalCloudHost);
  wifiManager.addParameter(portalCloudPort);
  wifiManager.addParameter(portalCloudUser);
  wifiManager.addParameter(portalCloudPassword);
  wifiManager.addParameter(portalCloudTopic);

  wifiManager.setSaveConfigCallback([]() { shouldSaveSettings = true; });
  wifiManager.setConfigPortalTimeout(0);
}

void capturePortalValues() {
  if (portalLocalHost) {
    copyToBuffer(localMqttHost, sizeof(localMqttHost), portalLocalHost->getValue());
  }
  if (portalLocalPort) {
    copyToBuffer(localMqttPort, sizeof(localMqttPort), portalLocalPort->getValue());
  }
  if (portalLocalUser) {
    copyToBuffer(localMqttUser, sizeof(localMqttUser), portalLocalUser->getValue());
  }
  if (portalLocalPassword) {
    const String submittedPassword = portalLocalPassword->getValue();
    // Some browser password fields submit an empty value unless the user enters
    // it again. Do not overwrite a previously saved password with an empty one.
    if (submittedPassword.length() > 0) {
      copyToBuffer(localMqttPassword, sizeof(localMqttPassword), submittedPassword);
    }
  }
  if (portalCloudHost) {
    copyToBuffer(cloudMqttHost, sizeof(cloudMqttHost), portalCloudHost->getValue());
  }
  if (portalCloudPort) {
    copyToBuffer(cloudMqttPort, sizeof(cloudMqttPort), portalCloudPort->getValue());
  }
  if (portalCloudUser) {
    copyToBuffer(cloudMqttUser, sizeof(cloudMqttUser), portalCloudUser->getValue());
  }
  if (portalCloudPassword) {
    const String submittedCloudPassword = portalCloudPassword->getValue();
    if (submittedCloudPassword.length() > 0) {
      copyToBuffer(cloudMqttPassword, sizeof(cloudMqttPassword), submittedCloudPassword);
    }
  }
  if (portalCloudTopic) {
    copyToBuffer(cloudMqttTopic, sizeof(cloudMqttTopic), portalCloudTopic->getValue());
  }

  if (shouldSaveSettings) {
    saveBrokerSettings();
    shouldSaveSettings = false;
  }

  Serial.printf("Local MQTT host: %s:%s | username: %s | password: %s\n",
                localMqttHost, localMqttPort, localMqttUser,
                strlen(localMqttPassword) > 0 ? "configured" : "MISSING");
}

void connectWiFiWithPhonePortal() {
  char setupPassword[11];
  const char alphabet[] = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";
  for (size_t i = 0; i < sizeof(setupPassword) - 1; ++i) {
    setupPassword[i] = alphabet[esp_random() % (sizeof(alphabet) - 1)];
  }
  setupPassword[sizeof(setupPassword) - 1] = '\0';
  Serial.printf("Setup AP: BEMS-ESP32S3 | password: %s\n", setupPassword);

  buildProvisioningPortal();
  const bool connected = wifiManager.autoConnect("BEMS-ESP32S3", setupPassword);
  if (!connected) {
    Serial.println("Wi-Fi setup did not finish. Restarting device.");
    delay(1000);
    ESP.restart();
  }

  capturePortalValues();
  Serial.print("Wi-Fi connected. ESP32-S3 IP: ");
  Serial.println(WiFi.localIP());
}

